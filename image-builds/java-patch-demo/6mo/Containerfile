# Six-month cohort. Change this file to change the base image.
# Library versions are pinned in 6mo/pom.xml.
# x86_64 UBI9 OpenJDK 21 from RHBA-2026:13502 (2026-05-04).
FROM registry.access.redhat.com/ubi9/openjdk-21:latest AS build
USER 0
WORKDIR /src
COPY 6mo/pom.xml pom.xml
COPY src ./src
RUN mvn -B -DskipTests package

FROM registry.access.redhat.com/ubi9/openjdk-21@sha256:2bb96bf0034ed62f317087cf64a05d48d0f250a66b1508b7e4053e2721a91106
LABEL org.opencontainers.image.title="Java patch demo 6mo" \
      demo.patch="6mo" \
      demo.base-image="registry.access.redhat.com/ubi9/openjdk-21@sha256:2bb96bf0034ed62f317087cf64a05d48d0f250a66b1508b7e4053e2721a91106"
ENV DEMO_PATCH=6mo \
    DEMO_BASE_IMAGE=registry.access.redhat.com/ubi9/openjdk-21@sha256:2bb96bf0034ed62f317087cf64a05d48d0f250a66b1508b7e4053e2721a91106 \
    HOME=/tmp \
    JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0"
COPY --from=build /src/target/java-patch-demo.jar /app/app.jar
WORKDIR /tmp
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
