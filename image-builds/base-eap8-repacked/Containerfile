ARG BASE_IMAGE=quay.io/mfoster/base-ubi9-openjdk:1.0
FROM registry.redhat.io/amq-streams/kafka-38-rhel9:2.8.0 AS rh-source
FROM --platform=linux/amd64 ${BASE_IMAGE}
LABEL org.opencontainers.image.title="Demo Base: Repacked JARs (no content manifests - negative control)"
LABEL org.opencontainers.image.version="1.0"
USER root
# JARs are copied out of the product image, so Red Hat content manifests stay behind.
# The copy is a real content layer on the platform OpenJDK base.
COPY --from=rh-source /opt/kafka/libs /opt/kafka/libs
COPY --from=rh-source /opt/cruise-control/libs /opt/cruise-control/libs
USER 185
CMD ["sleep", "infinity"]
